# Choose which provider powers the AI tutor: "gemini" (default), "anthropic", or "openai"
AI_PROVIDER=gemini

# Gemini (used when AI_PROVIDER=gemini) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — only used if you set AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — only used if you set AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o
